# data/graphiti/.env — read by the Graphiti stack only (never by agent containers).
# Keep this file mode 0600. The skill fills in the generated values.

# Neo4j password, generated at install. Changing it after first start requires
# resetting the neo4j_data volume.
NEO4J_PASSWORD=__GENERATED__

# Where the MCP server listens. The skill sets the bind address to what agent
# containers resolve host.docker.internal to.
GRAPHITI_BIND_ADDR=127.0.0.1
GRAPHITI_PORT=8000

# LLM used for entity/fact extraction: openai | anthropic | gemini | groq
LLM_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini

# Embeddings: openai | gemini | voyage (Anthropic has no embedder — pair
# LLM_PROVIDER=anthropic with one of these).
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=text-embedding-3-small

# Provide the key(s) for the providers chosen above.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# VOYAGE_API_KEY=

# Episodes processed concurrently. Lower this if the LLM provider returns 429s
# (OpenAI tier 1: 1-2, tier 3: 10; Anthropic default: 5-8).
SEMAPHORE_LIMIT=5
