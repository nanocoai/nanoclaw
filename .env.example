# Name the assistant answers to. Used as the WhatsApp trigger (@<name>) and as
# the outgoing-message prefix ("<name>: ...") unless the bot has its own number.
ASSISTANT_NAME=Andy

# Set true only if the bot runs on a dedicated phone number; suppresses the
# "<name>: " prefix on outbound replies and disables self-message detection.
ASSISTANT_HAS_OWN_NUMBER=false
