{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  // No rootDir: the dev-child-sync executable lives in the code-mode skill
  // tree (bun runs it type-stripped from an RO mount), and this noEmit-only
  // config is the one wired suite that typechecks it.
  "include": ["src/**/*", "../code-mode/skills/dev-child-sync/child-sync.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
