
# Optional: override data directory (SQLite messages.db lives under store/)
# STORE_DIR=/path/to/store

# Central admin DB backend: sqlite (default) or seekdb — see docs/db-seekdb.md
# NANOCLAW_CENTRAL_DB_BACKEND=sqlite

# SeekDB embedded (default when backend=seekdb; no SEEKDB_HOST/PORT)
# NANOCLAW_CENTRAL_DB_BACKEND=seekdb
# SEEKDB_PATH=seekdb.db
# SEEKDB_DATABASE=test

# SeekDB server — set SEEKDB_HOST and/or SEEKDB_PORT (MySQL protocol, often 2881)
# NANOCLAW_CENTRAL_DB_BACKEND=seekdb
# SEEKDB_HOST=127.0.0.1
# SEEKDB_PORT=2881
# SEEKDB_USER=root
# SEEKDB_PASSWORD=
# SEEKDB_DATABASE=test
