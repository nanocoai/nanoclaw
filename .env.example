# NanoClaw configuration. Copy to `.env` and fill in. Keep `.env` out of git.

# ── Credentials ───────────────────────────────────────────────────────────
# Setting ANY of the four keys below puts the install in "direct" credential
# mode: the host injects the credential straight into agent containers and
# bypasses the OneCLI gateway (no gateway container, no approval long-poll).
# Leave them all blank to use the OneCLI gateway instead. See src/config.ts
# (CREDENTIAL_MODE).

# Claude subscription OAuth token. Get it with `claude setup-token` and paste
# the result here — it starts with sk-ant-oat... The Claude Agent SDK runs the
# OAuth flow (Bearer + anthropic-beta header) natively. Preferred for
# subscription auth.
CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic API key (sk-ant-api...) — pay-as-you-go billing instead of a
# subscription token.
ANTHROPIC_API_KEY=

# Bearer auth token for an Anthropic-compatible endpoint. Use with
# ANTHROPIC_BASE_URL when pointing at a gateway/proxy that expects an
# Authorization: Bearer header.
ANTHROPIC_AUTH_TOKEN=

# Base URL for an Anthropic-compatible endpoint. Leave blank to use
# api.anthropic.com.
ANTHROPIC_BASE_URL=

# ── Assistant ─────────────────────────────────────────────────────────────
ASSISTANT_NAME=Andy

# ── OneCLI gateway (only used when no credential key above is set) ──────────
ONECLI_URL=
ONECLI_API_KEY=
